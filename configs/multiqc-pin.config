// Pins MultiQC to a container older than the broken 1.34 Wave build
// (community.wave.seqera.io/library/multiqc:1.34--db7c73dae76bc9e6), which crashes with
// `AttributeError: module 'rich' has no attribute 'panel'` - an upstream MultiQC/rich
// version mismatch inside that specific container, unrelated to this repo's own code.
process {
    withName: 'MULTIQC' {
        container = 'quay.io/biocontainers/multiqc:1.25.1--pyhdfd78af_0'
    }
}
