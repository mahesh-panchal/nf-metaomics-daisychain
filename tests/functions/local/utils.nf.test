    test("Test Function createMagSamplesheet - empty Dir") {

        function "createMagSamplesheet"

        when {
            function {
                """
                input[0] = ''
                """
            }
        }

        then {
            assert !function.success
            assert snapshot(function.result).match()
        }

    }

    // Same nf-test function-scope limitation as createMagSamplesheet above: calling
    // a channel-returning function with a falsy literal outside a real workflow
    // context errors in the harness itself, not in our function's logic (verified:
    // the equivalent call inside an actual `workflow {}` block returns Channel.value([])
